{
  "name": "task-management-api",
  "version": "1.0.0",
  "description": "A simple task management API",
  "license": "ISC",
  "author": "Surath",
  "main": "index.js",
  "scripts": {
    "build": "ts-node ./scripts/build.ts",
    "clean-install": "rm -rf ./node_modules && rm -r package-lock.json && npm i",
    "dev": "cross-env NODE_ENV=development ts-node ./src/index",
    "dev:hot": "nodemon --exec \"npm run dev\" --watch ./src --ext .ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "start": "cross-env NODE_ENV=production node -r ./config.js ./dist/index",
    "test": "cross-env NODE_ENV=test vitest",
    "type-check": "tsc -b --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-mssql": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jet-logger": "^2.2.3",
    "module-alias": "^2.2.3"
  },
  "devDependencies": {
    "@swc/core": "^1.15.8",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/module-alias": "^2.0.4",
    "@types/mssql": "^9.1.9",
    "@types/node": "^25.0.9",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.23.2",
    "fs-extra": "^11.3.3",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.0",
    "prisma": "^7.2.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vitest": "^4.0.17"
  }
}
